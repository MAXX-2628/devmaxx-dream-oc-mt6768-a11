#!/sbin/sh
# BCR system installer - writes BCR directly into /system/priv-app so it
# works as a real privileged system app, independent of KernelSU/modules.
#
# Safety: every file/dir this script creates is tracked as it goes. If ANY
# step fails (mount, space check, extract, copy, chmod, chcon), everything
# tracked so far is deleted immediately and the script exits - /system is
# never left in a half-modified state.

OUTFD=$2
ZIPFILE=$3

ui_print() {
  echo "ui_print $1" >&$OUTFD
  echo "ui_print" >&$OUTFD
}

CREATED_FILES=""
CREATED_DIRS=""

track_file() { CREATED_FILES="$CREATED_FILES $1"; }
track_dir() { CREATED_DIRS="$1 $CREATED_DIRS"; }  # prepend: deepest dir removed first

rollback() {
  ui_print "- Rolling back..."
  for f in $CREATED_FILES; do
    [ -e "$f" ] && rm -f "$f"
  done
  for d in $CREATED_DIRS; do
    [ -d "$d" ] && rmdir "$d" 2>/dev/null
  done
  ui_print "- Rollback complete, /system unchanged"
}

abort_rollback() {
  ui_print "! Error: $1"
  rollback
  exit 1
}

ui_print "- BCR system installer (com.chiller3.bcr)"

mount /system 2>/dev/null
mount -o rw,remount /system 2>/dev/null
if [ ! -w /system ]; then
  abort_rollback "Cannot mount /system read-write"
fi

# -P forces POSIX output (one line per fs, fixed column order) so this
# works consistently across busybox/toybox/coreutils df variants, which
# otherwise format columns differently - especially on dynamic-partition
# devices where /system is a logical (device-mapper) mount.
AVAIL=$(df -P /system 2>/dev/null | awk 'NR==2 {print $4}')
if [ -n "$AVAIL" ] && [ "$AVAIL" -lt 20000 ] 2>/dev/null; then
  abort_rollback "Not enough free space on /system (need ~20MB free, have ${AVAIL}KB)"
fi
if [ -z "$AVAIL" ]; then
  ui_print "- Warning: could not determine free space on /system, proceeding anyway"
  ui_print "- (the copy steps below still safely abort+rollback if they actually run out of space)"
fi

WORKDIR=/tmp/bcr_install
rm -rf "$WORKDIR"
mkdir -p "$WORKDIR"
cd "$WORKDIR" || abort_rollback "cannot create work dir"

unzip -o "$ZIPFILE" "app-release.apk" "privapp-permissions-com.chiller3.bcr.xml" -d "$WORKDIR" >&2

if [ ! -f "$WORKDIR/app-release.apk" ]; then
  abort_rollback "app-release.apk missing from zip"
fi
if [ ! -f "$WORKDIR/privapp-permissions-com.chiller3.bcr.xml" ]; then
  abort_rollback "privapp-permissions xml missing from zip"
fi

if [ ! -d /system/priv-app/com.chiller3.bcr ]; then
  mkdir -p /system/priv-app/com.chiller3.bcr || abort_rollback "mkdir /system/priv-app/com.chiller3.bcr failed"
  track_dir /system/priv-app/com.chiller3.bcr
fi

cp "$WORKDIR/app-release.apk" /system/priv-app/com.chiller3.bcr/app-release.apk \
  || abort_rollback "copy app-release.apk failed"
track_file /system/priv-app/com.chiller3.bcr/app-release.apk

cp "$WORKDIR/privapp-permissions-com.chiller3.bcr.xml" /system/etc/permissions/privapp-permissions-com.chiller3.bcr.xml \
  || abort_rollback "copy privapp-permissions xml failed"
track_file /system/etc/permissions/privapp-permissions-com.chiller3.bcr.xml

chmod 0644 /system/priv-app/com.chiller3.bcr/app-release.apk \
           /system/etc/permissions/privapp-permissions-com.chiller3.bcr.xml \
  || abort_rollback "chmod failed"
chmod 0755 /system/priv-app/com.chiller3.bcr \
  || abort_rollback "chmod dir failed"

chcon u:object_r:system_file:s0 /system/priv-app/com.chiller3.bcr 2>/dev/null
chcon u:object_r:system_file:s0 /system/priv-app/com.chiller3.bcr/app-release.apk 2>/dev/null
chcon u:object_r:system_file:s0 /system/etc/permissions/privapp-permissions-com.chiller3.bcr.xml 2>/dev/null

rm -rf "$WORKDIR"

ui_print "- BCR installed to /system/priv-app successfully"
ui_print "- Reboot to finish"

mount -o ro,remount /system 2>/dev/null

exit 0
